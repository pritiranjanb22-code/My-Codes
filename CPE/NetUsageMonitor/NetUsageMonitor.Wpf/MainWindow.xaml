<Window x:Class="NetUsageMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetUsageMonitor.Wpf.ViewModels"
        xmlns:views="clr-namespace:NetUsageMonitor.Wpf.Views"
        xmlns:converters="clr-namespace:NetUsageMonitor.Wpf.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" MinWidth="240" Width="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header -->
                <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" Padding="20,15">
                    <StackPanel>
                        <TextBlock Text="NetUsage Monitor" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="ISP Traffic Monitoring" FontSize="11" Foreground="White" Opacity="0.8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,16">
                    <StackPanel>
                        <views:NavButton Icon="📊" Text="Dashboard" Command="{Binding NavigateToDashboardCommand}" 
                                         IsSelected="{Binding CurrentViewModel, Converter={x:Static views:DashboardViewModel.IsTypeConverter}}"/>
                        <views:NavButton Icon="📈" Text="Live Monitoring" Command="{Binding NavigateToLiveMonitoringCommand}"/>
                        <views:NavButton Icon="👥" Text="Friends" Command="{Binding NavigateToFriendsCommand}"/>
                        <views:NavButton Icon="🌐" Text="Devices" Command="{Binding NavigateToDevicesCommand}"/>
                        <views:NavButton Icon="📋" Text="Usage Reports" Command="{Binding NavigateToReportsCommand}"/>
                        <views:NavButton Icon="⚠️" Text="Alerts" Command="{Binding NavigateToAlertsCommand}" 
                                         Badge="{Binding ActiveAlertCount}" BadgeVisibility="{Binding ActiveAlertCount, Converter={StaticResource BoolToVis}}"/>
                        <views:NavButton Icon="⚙️" Text="Settings" Command="{Binding NavigateToSettingsCommand}"/>
                        <views:NavButton Icon="🔧" Text="Diagnostics" Command="{Binding NavigateToDiagnosticsCommand}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="{DynamicResource SidebarFooterBrush}" Padding="16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="10" Height="10" Fill="{Binding IsMonitoringActive, Converter={StaticResource BoolToVis}, ConverterParameter=Green;Red}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsMonitoringActive, Converter={x:Static views:MonitoringStatusConverter.Instance}}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                        <Button Content="Run Setup Wizard" Command="{Binding RunSetupWizardCommand}" 
                                Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        <Button Content="{Binding IsMonitoringActive, Converter={x:Static views:ToggleMonitoringTextConverter.Instance}}" 
                                Command="{Binding ToggleMonitoringCommand}" 
                                Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}">
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LiveMonitoringViewModel}">
                        <views:LiveMonitoringView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FriendsViewModel}">
                        <views:FriendsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
                        <views:DevicesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <views:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
                        <views:AlertsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                        <views:DiagnosticsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>