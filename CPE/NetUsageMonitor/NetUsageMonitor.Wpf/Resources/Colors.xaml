<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors (Default) -->
    <Color x:Key="WindowBackgroundColor">#F5F5F5</Color>
    <Color x:Key="ContentBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#FAFAFA</Color>
    <Color x:Key="SidebarFooterColor">#F0F0F0</Color>
    <Color x:Key="PrimaryColor">#1976D2</Color>
    <Color x:Key="PrimaryDarkColor">#1565C0</Color>
    <Color x:Key="PrimaryLightColor">#BBDEFB</Color>
    <Color x:Key="AccentColor">#1976D2</Color>
    <Color x:Key="SecondaryColor">#757575</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="ErrorColor">#F44336</Color>
    <Color x:Key="InfoColor">#2196F3</Color>
    <Color x:Key="TextPrimaryColor">#212121</Color>
    <Color x:Key="TextSecondaryColor">#757575</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="HoverBackgroundColor">#E3F2FD</Color>
    <Color x:Key="SelectedBackgroundColor">#BBDEFB</Color>
    <Color x:Key="DisabledColor">#BDBDBD</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Dark Theme Colors -->
    <Color x:Key="WindowBackgroundColorDark">#121212</Color>
    <Color x:Key="ContentBackgroundColorDark">#1E1E1E</Color>
    <Color x:Key="SidebarBackgroundColorDark">#1E1E1E</Color>
    <Color x:Key="SidebarFooterColorDark">#252525</Color>
    <Color x:Key="PrimaryColorDark">#90CAF9</Color>
    <Color x:Key="PrimaryDarkColorDark">#64B5F6</Color>
    <Color x:Key="PrimaryLightColorDark">#1565C0</Color>
    <Color x:Key="AccentColorDark">#90CAF9</Color>
    <Color x:Key="SecondaryColorDark">#B0BEC5</Color>
    <Color x:Key "SuccessColorDark">#81C784</Color>
    <Color x:Key="WarningColorDark">#FFB74D</Color>
    <Color x:Key="ErrorColorDark">#EF5350</Color>
    <Color x:Key="InfoColorDark">#64B5F6</Color>
    <Color x:Key="TextPrimaryColorDark">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColorDark">#B0BEC5</Color>
    <Color x:Key="BorderColorDark">#333333</Color>
    <Color x:Key="CardBackgroundColorDark">#252525</Color>
    <Color x:Key="HoverBackgroundColorDark">#333333</Color>
    <Color x:Key="SelectedBackgroundColorDark">#1565C0</Color>
    <Color x:Key="DisabledColorDark">#666666</Color>

    <!-- Brushes (Light Theme Default) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarFooterBrush" Color="{StaticResource SidebarFooterColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackgroundColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningStatusBrush" Color="{StaticResource WarningColor}"/>
</ResourceDictionary>