<UserControl x:Class="NetUsageMonitor.Wpf.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NetUsageMonitor.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:AlertsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Alerts" Style="{DynamicResource Header1Style}"/>
                    <TextBlock Text="Monitor and manage usage alerts" Style="{DynamicResource SubtitleStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Active Alerts -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,16">
                        <TextBlock Text="Active Alerts" Style="{DynamicResource Header3Style}"/>
                        <TextBlock Text="{Binding Alerts.Count, StringFormat='{0} active'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <DataGrid ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
                            <DataGridTemplateColumn Header="Severity" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding SeverityColor}" CornerRadius="4" Padding="4,2" Width="80" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Severity}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="100"/>
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Acknowledge" Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <TextBlock Text="No active alerts" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,16"
                               Visibility="{Binding Alerts.Count, Converter={x:Static converters:CountToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                </StackPanel>
            </Border>

            <!-- Alert Rules -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,16">
                        <TextBlock Text="Alert Rules" Style="{DynamicResource Header3Style}"/>
                        <Button Content="Add Rule" Command="{Binding AddRuleCommand}" Style="{DynamicResource PrimaryButtonStyle}"/>
                    </StackPanel>
                    
                    <DataGrid ItemsSource="{Binding AlertRules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceDisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                            <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdDisplay}" Width="120"/>
                            <DataGridTemplateColumn Header="Notifications" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding NotifyWindows}" IsEnabled="False" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Windows" VerticalAlignment="Center" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding NotifyInApp}" IsEnabled="False" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="In-App" VerticalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Triggered" Binding="{Binding TriggerCount}" Width="80"/>
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                                    Foreground="#F44336" BorderBrush="#F44336"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Edit Rule Form -->
            <Border Style="{DynamicResource CardStyle}" Visibility="{Binding IsEditingRule, Converter={x:Static converters:BooleanToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="Edit Alert Rule" Style="{DynamicResource Header3Style}" Margin="0,0,0,16"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Device" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableDevices}" DisplayMemberPath="DeviceDisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedRule.DeviceId}"/>

                            <TextBlock Text="Alert Type" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding SelectedRule.AvailableTypes}" SelectedItem="{Binding SelectedRule.Type}"/>

                            <TextBlock Text="Severity" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding SelectedRule.AvailableSeverities}" SelectedItem="{Binding SelectedRule.Severity}"/>

                            <TextBlock Text="Threshold (Bytes)" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding SelectedRule.ThresholdBytes}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <CheckBox Content="Enabled" IsChecked="{Binding SelectedRule.Enabled}" Margin="0,8,0,0"/>
                            <CheckBox Content="Windows Notification" IsChecked="{Binding SelectedRule.NotifyWindows}" Margin="0,8,0,0"/>
                            <CheckBox Content="In-App Notification" IsChecked="{Binding SelectedRule.NotifyInApp}" Margin="0,8,0,0"/>
                            
                            <TextBlock Text="Last Triggered" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SelectedRule.LastTriggered, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Text="Trigger Count" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SelectedRule.TriggerCount}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Cancel" Command="{Binding CancelRuleEditCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="Save" Command="{Binding SaveRuleCommand}" Style="{DynamicResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>