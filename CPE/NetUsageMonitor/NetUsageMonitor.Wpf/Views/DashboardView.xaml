<UserControl x:Class="NetUsageMonitor.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:NetUsageMonitor.Wpf.ViewModels"
             xmlns:converters="clr-namespace:NetUsageMonitor.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <UserControl.Resources>
        <converters:DataSizeToStringConverter x:Key="DataSizeToString"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{DynamicResource Header1Style}"/>
                    <TextBlock Text="Real-time internet usage monitoring for Friend A and Friend B" Style="{DynamicResource SubtitleStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="{Binding UseBinaryUnits, Converter={x:Static converters:UnitToggleTextConverter.Instance}}" 
                            Command="{Binding ToggleUnitsCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Cards -->
            <ItemsControl ItemsSource="{Binding StatusCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardStyleCompact}" Width="280" Margin="0,0,16,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Value, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding DataContext.UseBinaryUnits, RelativeSource={RelativeSource AncestorType=UserControl}}}" 
                                           FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Connection Status & Speed -->
            <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{DynamicResource CardStyleCompact}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{Binding ConnectionStatus, Converter={x:Static converters:ConnectionStatusToColorConverter.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Connection Status" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="16" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastUpdate, StringFormat='Last update: {0:HH:mm:ss}'}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Style="{DynamicResource CardStyleCompact}" MinWidth="160">
                        <StackPanel>
                            <TextBlock Text="⬇ Download Speed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentDownloadSpeed, StringFormat='{0:F2} Mbps'}" FontSize="20" FontWeight="Bold" Foreground="#2196F3"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardStyleCompact}" MinWidth="160" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="⬆ Upload Speed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentUploadSpeed, StringFormat='{0:F2} Mbps'}" FontSize="20" FontWeight="Bold" Foreground="#FF9800"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Usage Summary Cards -->
            <TextBlock Text="Usage Summary" Style="{DynamicResource Header3Style}"/>
            <WrapPanel Margin="0,8,0,16">
                <Border Style="{DynamicResource CardStyleCompact}" Width="260" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="👤 Friend A" FontSize="13" FontWeight="Medium" Foreground="#1976D2"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⬇" FontSize="12" Foreground="#2196F3"/>
                                <TextBlock Text="{Binding FriendADownload, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="⬆" FontSize="12" Foreground="#FF9800"/>
                                <TextBlock Text="{Binding FriendAUpload, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Σ" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding FriendATotal, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyleCompact}" Width="260" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="👤 Friend B" FontSize="13" FontWeight="Medium" Foreground="#FF9800"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⬇" FontSize="12" Foreground="#2196F3"/>
                                <TextBlock Text="{Binding FriendBDownload, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="⬆" FontSize="12" Foreground="#FF9800"/>
                                <TextBlock Text="{Binding FriendBUpload, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Σ" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding FriendBTotal, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyleCompact}" Width="260" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="📊 Total" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⬇" FontSize="12" Foreground="#2196F3"/>
                                <TextBlock Text="{Binding TotalDownload, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="⬆" FontSize="12" Foreground="#FF9800"/>
                                <TextBlock Text="{Binding TotalUpload, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Period Usage Cards -->
            <WrapPanel Margin="0,0,0,24">
                <Border Style="{DynamicResource CardStyleCompact}" Width="200" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="📅 Today" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DailyUsage, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource CardStyleCompact}" Width="200" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="📆 This Week" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WeeklyUsage, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource CardStyleCompact}" Width="200" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="📅 This Month" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding MonthlyUsage, Converter={StaticResource DataSizeToString}, ConverterParameter={Binding UseBinaryUnits}}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Charts -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Usage Comparison" Style="{DynamicResource Header3Style}"/>
                        <lvc:CartesianChart Series="{Binding UsageComparisonSeries}" XAxes="{Binding XAxis}" YAxes="{Binding YAxis}" Height="300" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Daily Usage (Last 7 Days)" Style="{DynamicResource Header3Style}"/>
                        <lvc:CartesianChart Series="{Binding DailyUsageSeries}" XAxes="{Binding XAxis}" YAxes="{Binding YAxis}" Height="300" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Weekly Usage" Style="{DynamicResource Header3Style}"/>
                        <lvc:CartesianChart Series="{Binding WeeklyUsageSeries}" XAxes="{Binding XAxis}" YAxes="{Binding YAxis}" Height="300" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Monthly Usage" Style="{DynamicResource Header3Style}"/>
                        <lvc:CartesianChart Series="{Binding MonthlyUsageSeries}" XAxes="{Binding XAxis}" YAxes="{Binding YAxis}" Height="300" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>