<UserControl x:Class="NetUsageMonitor.Wpf.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NetUsageMonitor.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:DevicesViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Devices" Style="{DynamicResource Header1Style}"/>
                    <TextBlock Text="Configure and manage monitored routers" Style="{DynamicResource SubtitleStyle}"/>
                </StackPanel>
                <Button Content="Add Device" Command="{Binding AddDeviceCommand}" Style="{DynamicResource PrimaryButtonStyle}"/>
            </StackPanel>

            <!-- Device List -->
            <Border Style="{DynamicResource CardStyle}">
                <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Friend" Binding="{Binding FriendName}" Width="100"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="100"/>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130"/>
                        <DataGridTextColumn Header="Collector" Binding="{Binding CollectorType}" Width="100"/>
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding MonitoringEnabled, Converter={x:Static converters:BooleanToBrushConverter.Instance}, ConverterParameter=Green;Gray}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding MonitoringEnabled, Converter={x:Static converters:BooleanToStatusTextConverter.Instance}, ConverterParameter=Enabled;Disabled}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Last Test" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastTestResult}" FontWeight="Medium" 
                                                   Foreground="{Binding LastTestResult, Converter={x:Static converters:TestResultToColorConverter.Instance}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastTestTime, StringFormat=' ({0:HH:mm})'}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Edit" Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0" FontSize="11"/>
                                        <Button Content="Test" Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0" FontSize="11"/>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                                Foreground="#F44336" BorderBrush="#F44336"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Add/Edit Device Dialog -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,24,0,0" Visibility="{Binding ShowAddDeviceDialog, Converter={x:Static converters:BooleanToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding IsEditing, Converter={x:Static converters:BoolToEditTextConverter.Instance}}" Style="{DynamicResource Header3Style}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Basic Info -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <GroupBox Header="Basic Information">
                                <StackPanel>
                                    <TextBlock Text="Device Name" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding SelectedDevice.Name}"/>

                                    <TextBlock Text="Friend Name" Margin="0,8,0,4"/>
                                    <ComboBox ItemsSource="{Binding FriendNames}" SelectedItem="{Binding SelectedDevice.FriendName}" IsEditable="True"/>

                                    <TextBlock Text="Device Type" Margin="0,8,0,4"/>
                                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding SelectedDevice.DeviceType}"/>

                                    <TextBlock Text="IP Address / Hostname" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding SelectedDevice.IpAddress}"/>

                                    <TextBlock Text="Port" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding SelectedDevice.Port}"/>

                                    <CheckBox Content="Enable Monitoring" IsChecked="{Binding SelectedDevice.MonitoringEnabled}" Margin="0,8,0,0"/>
                                    <CheckBox Content="Reverse Upload/Download" IsChecked="{Binding SelectedDevice.ReverseDirection}" Margin="0,8,0,0"/>

                                    <TextBlock Text="Polling Interval (seconds)" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding SelectedDevice.PollingIntervalSeconds}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Collector Settings -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <GroupBox Header="Collector Settings">
                                <StackPanel>
                                    <TextBlock Text="Collector Type" Margin="0,8,0,4"/>
                                    <ComboBox ItemsSource="{Binding CollectorTypes}" SelectedItem="{Binding SelectedDevice.CollectorType}"/>

                                    <!-- SNMP Settings -->
                                    <Border Visibility="{Binding SelectedDevice.CollectorType, Converter={x:Static converters:CollectorTypeToVisibilityConverter.Instance}, ConverterParameter=Snmp}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="SNMP Version" Margin="0,8,0,4"/>
                                            <ComboBox ItemsSource="{Binding SnmpVersions}" SelectedItem="{Binding SelectedDevice.SnmpVersion}"/>

                                            <TextBlock Text="Community (v2c)" Margin="0,8,0,4" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V2c}"/>
                                            <TextBox Text="{Binding SelectedDevice.Community}" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V2c}"/>

                                            <TextBlock Text="Username (v3)" Margin="0,8,0,4" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>
                                            <TextBox Text="{Binding SelectedDevice.SnmpUsername}" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>

                                            <TextBlock Text="Auth Protocol" Margin="0,8,0,4" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>
                                            <ComboBox ItemsSource="{Binding AuthProtocols}" SelectedItem="{Binding SelectedDevice.SnmpAuthProtocol}" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>

                                            <TextBlock Text="Auth Password" Margin="0,8,0,4" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>
                                            <TextBox Text="{Binding SelectedDevice.SnmpAuthPassword}" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>

                                            <TextBlock Text="Priv Protocol" Margin="0,8,0,4" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>
                                            <ComboBox ItemsSource="{Binding PrivProtocols}" SelectedItem="{Binding SelectedDevice.SnmpPrivProtocol}" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>

                                            <TextBlock Text="Priv Password" Margin="0,8,0,4" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>
                                            <TextBox Text="{Binding SelectedDevice.SnmpPrivPassword}" Visibility="{Binding SelectedDevice.SnmpVersion, Converter={x:Static converters:SnmpVersionToVisibilityConverter.Instance}, ConverterParameter=V3}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Router API Settings -->
                                    <Border Visibility="{Binding SelectedDevice.CollectorType, Converter={x:Static converters:CollectorTypeToVisibilityConverter.Instance}, ConverterParameter=RouterApi}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="API Type" Margin="0,8,0,4"/>
                                            <ComboBox ItemsSource="{Binding ApiTypes}" SelectedItem="{Binding SelectedDevice.ApiType}"/>

                                            <TextBlock Text="Base URL" Margin="0,8,0,4"/>
                                            <TextBox Text="{Binding SelectedDevice.ApiBaseUrl}"/>

                                            <TextBlock Text="Username" Margin="0,8,0,4"/>
                                            <TextBox Text="{Binding SelectedDevice.ApiUsername}"/>

                                            <TextBlock Text="Password" Margin="0,8,0,4"/>
                                            <TextBox Text="{Binding SelectedDevice.ApiPassword}"/>

                                            <TextBlock Text="API Key" Margin="0,8,0,4"/>
                                            <TextBox Text="{Binding SelectedDevice.ApiKey}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- Interface Selection -->
                            <GroupBox Header="Interface Selection" Margin="0,16,0,0">
                                <StackPanel>
                                    <Button Content="Discover Interfaces" Command="{Binding DiscoverInterfacesCommand}" CommandParameter="{Binding SelectedDevice}" 
                                            Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding SelectedDevice.AvailableInterfaces}" 
                                              DisplayMemberPath="DisplayName" 
                                              SelectedValuePath="Index"
                                              SelectedValue="{Binding SelectedDevice.InterfaceId}"
                                              Margin="0,8,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="Save" Command="{Binding SaveDeviceCommand}" Style="{DynamicResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>