<UserControl x:Class="NetUsageMonitor.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:NetUsageMonitor.Wpf.ViewModels"
             xmlns:converters="clr-namespace:NetUsageMonitor.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}">
    <UserControl.Resources>
        <converters:DataSizeToStringConverter x:Key="DataSizeToString"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Usage Reports" Style="{DynamicResource Header1Style}"/>
                    <TextBlock Text="Generate and export detailed usage reports" Style="{DynamicResource SubtitleStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Filters -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Filters" Style="{DynamicResource Header3Style}" Margin="0,0,0,16"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Friends" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding AvailableDevices}" 
                                     SelectionMode="Multiple"
                                     SelectedValuePath="FriendName"
                                     DisplayMemberPath="FriendName"
                                     Height="80">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="4"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <TextBlock Text="Period" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="12,0,12,0" Visibility="{Binding SelectedPeriod, Converter={x:Static converters:PeriodToVisibilityConverter.Instance}, ConverterParameter=Custom}">
                            <TextBlock Text="From Date" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding CustomFromDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="12,0,0,0" Visibility="{Binding SelectedPeriod, Converter={x:Static converters:PeriodToVisibilityConverter.Instance}, ConverterParameter=Custom}">
                            <TextBlock Text="To Date" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding CustomToDate}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Include Hourly Data" IsChecked="{Binding IncludeHourlyData}" Margin="0,16,0,0"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Generate Report" Command="{Binding GenerateReportCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Report Summary -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Visibility="{Binding CurrentReport, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="Report Summary" Style="{DynamicResource Header3Style}" Margin="0,0,0,16"/>
                    
                    <DataGrid ItemsSource="{Binding CurrentReport.Summaries}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Friend" Binding="{Binding FriendName}" Width="*"/>
                            <DataGridTextColumn Header="Download" Binding="{Binding DownloadBytes, Converter={StaticResource DataSizeToString}}" Width="*"/>
                            <DataGridTextColumn Header="Upload" Binding="{Binding UploadBytes, Converter={StaticResource DataSizeToString}}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalBytes, Converter={StaticResource DataSizeToString}}" Width="*"/>
                            <DataGridTextColumn Header="Peak Down (Mbps)" Binding="{Binding PeakDownloadMbps, StringFormat='{0:F2}'}" Width="*"/>
                            <DataGridTextColumn Header="Peak Up (Mbps)" Binding="{Binding PeakUploadMbps, StringFormat='{0:F2}'}" Width="*"/>
                            <DataGridTextColumn Header="Days" Binding="{Binding DaysWithData}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Comparison -->
                    <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CurrentReport.Comparison.FriendAName}" FontWeight="Bold" Foreground="#1976D2"/>
                                <TextBlock Text="{Binding CurrentReport.Comparison.FriendATotal, Converter={StaticResource DataSizeToString}}"/>
                                <TextBlock Text="{Binding CurrentReport.Comparison.FriendAPercentage, StringFormat='{0:F1}% of total'}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="vs" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CurrentReport.Comparison.FriendBName}" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CurrentReport.Comparison.FriendBTotal, Converter={StaticResource DataSizeToString}}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CurrentReport.Comparison.FriendBPercentage, StringFormat='{0:F1}% of total'}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Charts -->
            <Grid Visibility="{Binding CurrentReport, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Daily Usage" Style="{DynamicResource Header3Style}"/>
                        <lvc:CartesianChart Series="{Binding DailyChartSeries}" XAxes="{Binding XAxis}" YAxes="{Binding YAxis}" Height="350" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Visibility="{Binding CurrentReport.HourlyData.Count, Converter={x:Static converters:CountToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="Hourly Usage" Style="{DynamicResource Header3Style}"/>
                        <lvc:CartesianChart Series="{Binding HourlyChartSeries}" XAxes="{Binding XAxis}" YAxes="{Binding YAxis}" Height="350" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>