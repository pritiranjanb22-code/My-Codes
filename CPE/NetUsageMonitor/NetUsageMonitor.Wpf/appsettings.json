{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "NetUsageMonitor": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "DatabasePath": "%LOCALAPPDATA%\\NetUsageMonitor\\netusagemonitor.db",
    "LogPath": "%LOCALAPPDATA%\\NetUsageMonitor\\logs\\",
    "DefaultPollingIntervalSeconds": 60,
    "DefaultRetentionDays": 365
  }
}