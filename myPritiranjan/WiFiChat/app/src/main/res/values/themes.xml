<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WiFiChat" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/wifichat_primary</item>
        <item name="colorPrimaryVariant">@color/wifichat_primary_variant</item>
        <item name="colorOnPrimary">@color/wifichat_on_primary</item>
        <item name="colorSecondary">@color/wifichat_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorBackground">@color/wifichat_background</item>
        <item name="colorOnBackground">@color/wifichat_on_background</item>
        <item name="colorSurface">@color/wifichat_surface</item>
        <item name="colorOnSurface">@color/wifichat_on_surface</item>
        <item name="colorError">@color/wifichat_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:statusBarColor">@color/wifichat_background</item>
        <item name="android:navigationBarColor">@color/wifichat_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    
    <style name="Theme.WiFiChat.Call" parent="Theme.WiFiChat">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <style name="Theme.WiFiChat.Dialog" parent="Theme.Material3.Dark.Dialog">
        <item name="colorSurface">@color/wifichat_surface</item>
        <item name="colorOnSurface">@color/wifichat_on_surface</item>
    </style>
</resources>