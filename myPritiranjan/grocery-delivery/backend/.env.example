# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grocery_delivery
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URLs (for CORS)
MOBILE_APP_URL=exp://192.168.1.x:8081
ADMIN_DASHBOARD_URL=http://localhost:5173

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Cloud Storage (for product images, payment screenshots)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@grocerydelivery.com

# Shop Configuration (defaults, can be overridden in admin settings)
SHOP_NAME=Fresh Mart Grocery
SHOP_PHONE=+91-9876543210
SHOP_ADDRESS=123 Main Street, City, State - 123456
SHOP_OPENING_HOURS=08:00-22:00
SHOP_LOGO_URL=
DEFAULT_DELIVERY_RADIUS_KM=10
DEFAULT_DELIVERY_CHARGE=30
FREE_DELIVERY_THRESHOLD=500
MIN_ORDER_VALUE=100

# UPI Payment Configuration (can be overridden in admin settings)
UPI_ID=shopname@upi
UPI_QR_CODE_URL=
PAYMENT_INSTRUCTIONS=Please pay the exact amount using any UPI app and enter the transaction ID (UTR) in the app.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12